NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3001
# Comma-separated frontend origins allowed to make browser requests.
TRUSTED_ORIGINS=http://localhost:3001
# The public base URL of this API. Used when returning local upload URLs.
API_PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Keep "lax" for same-site frontend/API deployments. "none" requires HTTPS.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Local-development avatar storage. Replace the local upload service with a
# Cloudinary or Cloudflare R2 adapter later without changing frontend callers.
UPLOADS_DIR=uploads
MAX_AVATAR_FILE_SIZE=5242880

# Generate a unique random value for irreversible visitor IP hashing.
VISITOR_HASH_SALT=replace-with-a-separate-long-random-secret

# Required only when deliberately creating the first administrator with
# `npm run db:seed`. Do not commit a real password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Gmail: enable two-step verification, create an App Password, then set these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM="Investra <your-gmail-address@gmail.com>"
