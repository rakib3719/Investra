generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  firstName           String?                @map("first_name") @db.VarChar
  lastName            String?                @map("last_name") @db.VarChar
  username            String?                @unique @map("username") @db.VarChar
  email               String                 @unique @map("email") @db.VarChar
  phone               String?                @unique @map("phone") @db.VarChar
  password            String                 @map("password") @db.VarChar
  image               String?                @map("image")
  role                UserRole               @map("role")
  gender              Gender?                @map("gender")
  dateOfBirth         DateTime?              @map("date_of_birth") @db.Date
  bio                 String?                @map("bio")
  country             String?                @map("country") @db.VarChar
  city                String?                @map("city") @db.VarChar
  professionalType    ProfessionalType?      @map("professional_type")
  website             String?                @map("website")
  isEmailVerified     Boolean                @default(false) @map("is_email_verified")
  isPhoneVerified     Boolean                @default(false) @map("is_phone_verified")
  isTwoFactorEnabled  Boolean                @default(false) @map("is_two_factor_enabled")
  tokenVersion        Int                    @default(0) @map("token_version")
  accountStatus       AccountStatus          @default(PENDING) @map("account_status")
  lastLoginAt         DateTime?              @map("last_login_at") @db.Timestamp(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamp(6)
  categoriesCreated   Category[]
  consultantProfile   ConsultantProfile?
  entrepreneurProfile EntrepreneurProfile?
  investorProfile     InvestorProfile?
  interests           UserInterestCategory[]
  socialLinks         UserSocialLink[]
  verification        UserVerification?
  refreshSessions     RefreshSession[]
  businesses          Business[]
  bookmarks           Bookmark[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Consent-based anonymous homepage visit. No raw IP address or raw user-agent
/// string is retained; the server stores an irreversible IP hash and parsed
/// browser/device details instead.
model VisitorInsight {
  id               String   @id @default(uuid()) @db.Uuid
  anonymousId      String   @map("anonymous_id") @db.VarChar
  ipHash           String   @map("ip_hash") @db.VarChar
  pagePath         String   @default("/") @map("page_path") @db.VarChar
  browserName      String?  @map("browser_name") @db.VarChar
  browserVersion   String?  @map("browser_version") @db.VarChar
  operatingSystem  String?  @map("operating_system") @db.VarChar
  deviceType       String?  @map("device_type") @db.VarChar
  language         String?  @map("language") @db.VarChar
  timezone         String?  @map("timezone") @db.VarChar
  screenWidth      Int?     @map("screen_width")
  screenHeight     Int?     @map("screen_height")
  viewportWidth    Int?     @map("viewport_width")
  viewportHeight   Int?     @map("viewport_height")
  referrer         String?  @map("referrer")
  locationConsent  Boolean  @default(false) @map("location_consent")
  latitude         Decimal? @map("latitude") @db.Decimal(9, 6)
  longitude        Decimal? @map("longitude") @db.Decimal(9, 6)
  locationAccuracy Int?     @map("location_accuracy")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt])
  @@index([anonymousId])
  @@index([ipHash])
  @@map("visitor_insights")
}

model InvestorProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  headline           String?            @map("headline") @db.VarChar
  investmentRangeMin Decimal?           @map("investment_range_min") @db.Decimal
  investmentRangeMax Decimal?           @map("investment_range_max") @db.Decimal
  preferredCurrency  String?            @map("preferred_currency") @db.VarChar
  yearsOfExperience  Int?               @map("years_of_experience")
  companyName        String?            @map("company_name") @db.VarChar
  designation        String?            @map("designation") @db.VarChar
  businessName       String?            @map("business_name") @db.VarChar
  businessIndustry   String?            @map("business_industry") @db.VarChar
  accreditedInvestor Boolean?           @map("accredited_investor")
  preferredStage     BusinessStage?     @map("preferred_stage")
  profileVisibility  Boolean?           @map("profile_visibility")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model EntrepreneurProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  headline           String?            @map("headline") @db.VarChar
  companyName        String?            @map("company_name") @db.VarChar
  designation        String?            @map("designation") @db.VarChar
  yearsOfExperience  Int?               @map("years_of_experience")
  website            String?            @map("website")
  linkedin           String?            @map("linkedin")
  facebook           String?            @map("facebook")
  twitter            String?            @map("twitter")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  profileVisibility  Boolean?           @map("profile_visibility")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entrepreneur_profiles")
}

model ConsultantProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  headline           String?            @map("headline") @db.VarChar
  specialization     String?            @map("specialization") @db.VarChar
  consultantLevel    ConsultantLevel?   @map("consultant_level")
  yearsOfExperience  Int?               @map("years_of_experience")
  companyName        String?            @map("company_name") @db.VarChar
  designation        String?            @map("designation") @db.VarChar
  consultationFee    Decimal?           @map("consultation_fee") @db.Decimal
  sessionFee         Decimal?           @map("session_fee") @db.Decimal
  workshopFee        Decimal?           @map("workshop_fee") @db.Decimal
  courseFee          Decimal?           @map("course_fee") @db.Decimal
  averageRating      Decimal?           @map("average_rating") @db.Decimal
  totalReviews       Int?               @map("total_reviews")
  profileVisibility  Boolean?           @map("profile_visibility")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consultant_profiles")
}

model UserSocialLink {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  platform  SocialPlatform @map("platform")
  url       String         @map("url")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_social_links")
}

model UserVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  nidNumber          String?            @map("nid_number") @db.VarChar
  passportNumber     String?            @map("passport_number") @db.VarChar
  documentFront      String?            @map("document_front")
  documentBack       String?            @map("document_back")
  selfieImage        String?            @map("selfie_image")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  reviewedBy         String?            @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamp(6)
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model Category {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @unique @map("name") @db.VarChar
  slug        String                 @unique @map("slug") @db.VarChar
  description String?                @map("description")
  icon        String?                @map("icon")
  image       String?                @map("image")
  color       String?                @map("color") @db.VarChar
  sortOrder   Int?                   @map("sort_order")
  isFeatured  Boolean?               @map("is_featured")
  status      CategoryStatus         @map("status")
  createdBy   String?                @map("created_by") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamp(6)
  creator     User?                  @relation(fields: [createdBy], references: [id])
  interest    UserInterestCategory[]
  businesses  Business[]

  @@map("categories")
}

model UserInterestCategory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("user_interest_categories")
}

enum UserRole {
  INVESTOR
  ENTREPRENEUR
  CONSULTANT
  ADMIN
  SUB_ADMIN

  @@map("user_role")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("account_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("gender")
}

enum ProfessionalType {
  EMPLOYEE
  BUSINESS_OWNER
  FREELANCER
  SELF_EMPLOYED
  STUDENT
  OTHER

  @@map("professional_type")
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum BusinessStage {
  IDEA
  MVP
  EARLY_STAGE
  GROWTH
  SCALING

  @@map("business_stage")
}

enum ConsultantLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT

  @@map("consultant_level")
}

enum SocialPlatform {
  FACEBOOK
  LINKEDIN
  TWITTER
  INSTAGRAM
  YOUTUBE
  GITHUB
  WEBSITE
  OTHER

  @@map("social_platform")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

model Business {
  id              String              @id @default(uuid()) @db.Uuid
  entrepreneurId  String              @map("entrepreneur_id") @db.Uuid
  title           String              @db.VarChar(255)
  slug            String              @unique @db.VarChar(255)
  tagline         String?             @db.VarChar(500)
  pitchText       String              @map("pitch_text") @db.Text
  categoryId      String              @map("category_id") @db.Uuid
  stage           BusinessStage       @default(IDEA)
  targetAmount    Decimal             @map("target_amount") @db.Decimal(14, 2)
  raisedAmount    Decimal             @default(0) @map("raised_amount") @db.Decimal(14, 2)
  minInvestment   Decimal             @map("min_investment") @db.Decimal(14, 2)
  projectedIrr    Decimal?            @map("projected_irr") @db.Decimal(5, 2)
  valuation       Decimal?            @db.Decimal(14, 2)
  riskLevel       RiskLevel           @default(MEDIUM) @map("risk_level")
  esgRating       String?             @map("esg_rating") @db.VarChar(10)
  impactMetric    String?             @map("impact_metric") @db.VarChar(255)
  bannerImage     String?             @map("banner_image")
  gallery         String[]            @default([])
  status          CampaignStatus      @default(DRAFT)
  rejectionReason String?             @map("rejection_reason") @db.Text
  isFeatured      Boolean             @default(false) @map("is_featured")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamp(6)

  entrepreneur    User                @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  category        Category            @relation(fields: [categoryId], references: [id])
  milestones      CampaignMilestone[]
  pitchDecks      PitchDeck[]
  bookmarks       Bookmark[]

  @@index([categoryId, status])
  @@index([entrepreneurId])
  @@index([status])
  @@map("businesses")
}

model CampaignMilestone {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  targetDate      DateTime? @map("target_date") @db.Date
  fundingNeeded   Decimal?  @map("funding_needed") @db.Decimal(14, 2)
  isCompleted     Boolean   @default(false) @map("is_completed")
  completionProof String?   @map("completion_proof") @db.Text
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("campaign_milestones")
}

model PitchDeck {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  title          String   @db.VarChar(255)
  fileUrl        String   @map("file_url")
  fileSize       Int?     @map("file_size")
  version        Int      @default(1)
  isConfidential Boolean  @default(false) @map("is_confidential")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("pitch_decks")
}

enum CampaignStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  REJECTED
  FUNDED
  CLOSED

  @@map("campaign_status")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("risk_level")
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("bookmarks")
}


